ENVIRONMENT=development
POCKETBASE_ADMIN_EMAIL=test@test.com
POCKETBASE_ADMIN_PASSWORD=12345678
POCKETBASE_PORT=8096
PROFILE=docker
POCKETBASE_OAUTH_TG_BOT_TOKEN=
POCKETBASE_ENCRYPTION_KEY=
AES_ENCRYPTION_MASTER_KEY=
MAX_TTL_MEMORY_CACHE_DURATION=10m

TELEGRAM_API_APP_ID=
TELEGRAM_API_APP_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

### Binance Configuration ###
BINANCE_BASE_URL=https://api.binance.com

# Core Rate Limiting & Capacity Management
BINANCE_DEFAULT_LIMIT=11500
BINANCE_RATE_LIMIT_THRESHOLD=0.80
BINANCE_BACKOFF_BASE_DURATION=1.5s

# Flight Throttling Controls
BINANCE_MAX_CONCURRENT_REQUESTS=8
BINANCE_MAX_REQUESTS_PER_SECOND=5
BINANCE_RETRY_COUNT=4
BINANCE_RETRY_MIN_DURATION=1.5s
BINANCE_RETRY_MAX_DURATION=30s

# Circuit Breaker Options
BINANCE_CB_MAX_FAILURES=15
BINANCE_CB_COOLDOWN_DURATION=45s
BINANCE_CB_HALF_OPEN_PROBE_LIMIT=1